# Public HTTPS in front of `things-orchestrator serve-http`.
# Private tailnet HTTPS uses Tailscale Serve instead; see docs/host.md.
# Leave the Python process on 127.0.0.1:8787. Do not publish port 8787.
# The process must outlive SSH — use deploy/serve-http.service or tmux.
# Host steps: docs/host.md.
#
#   uv run things-orchestrator serve-http
#   uv run things-orchestrator print-config --http --url https://mcp.example.com
#   caddy run --config deploy/Caddyfile
#
# Replace mcp.example.com with the hostname you passed to --url.

mcp.example.com {
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
	}
}
