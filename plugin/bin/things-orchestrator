#!/bin/sh
set -eu

TO_PLUGIN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TO_SOURCE_ROOT=$(CDPATH= cd -- "$TO_PLUGIN_ROOT/.." && pwd)
TO_LAUNCHER_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/things-orchestrator/launcher"
TO_LAUNCHER=""
if [ -f "$TO_LAUNCHER_FILE" ]; then
  TO_LAUNCHER=$(tr -d '\n' < "$TO_LAUNCHER_FILE")
fi
if [ -z "$TO_LAUNCHER" ] && [ -x "$TO_SOURCE_ROOT/.venv/bin/things-orchestrator" ]; then
  TO_LAUNCHER="$TO_SOURCE_ROOT/.venv/bin/things-orchestrator"
fi
if [ -z "$TO_LAUNCHER" ] || [ ! -x "$TO_LAUNCHER" ]; then
  echo "Run things-orchestrator login from the uv tool, or run uv sync in the clone." >&2
  exit 2
fi

case "${1:-}" in
  cloud-check|configure|login|service|serve|serve-http|print-config|doctor|support-bundle|skill-path|owner-factor|migration-report|legacy-reconcile|legacy-resolve|operation-show|operation-reconcile)
    exec "$TO_LAUNCHER" "$@"
    ;;
  *)
    echo "Usage: things-orchestrator {cloud-check,configure,login,service,serve,serve-http,print-config,doctor,support-bundle,skill-path,owner-factor,migration-report,legacy-reconcile,legacy-resolve,operation-show,operation-reconcile}" >&2
    exit 2
    ;;
esac
